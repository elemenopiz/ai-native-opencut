# Byorn AI Backend — Environment Variables
# Copy this file to .env and update values as needed.
# All variables are prefixed with BYORN_ (see app/config.py).

# Server
BYORN_HOST=0.0.0.0
BYORN_PORT=8420
BYORN_DEBUG=false

# CORS — origins allowed to call this API (JSON array)
# BYORN_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Ollama LLM
BYORN_OLLAMA_URL=http://localhost:11434
# Kimi K2 GGUF models (pull from Ollama registry):
#   kimi-k2:latest       — Q3_K_M, ~1.4 GB  (Lite tier)
#   kimi-k2:q4_K_M       — Q4_K_M, ~3.0 GB  (Standard tier)
#   kimi-k2:q5_K_M       — Q5_K_M, ~7.0 GB  (Pro tier)
# Other models: llama3.2:1b, llama3.2:3b-instruct-q4_K_M, llama3.1:8b-instruct-q4_K_M, mistral:7b-instruct-q4_K_M
BYORN_OLLAMA_DEFAULT_MODEL=llama3.2
BYORN_OLLAMA_TIMEOUT=120

# Whisper speech-to-text
# Model sizes: tiny, base, small, medium, large-v3
BYORN_WHISPER_MODEL_SIZE=base
# Device: auto (uses GPU if available), cpu, cuda
BYORN_WHISPER_DEVICE=auto
# Compute type: int8, float16, float32
BYORN_WHISPER_COMPUTE_TYPE=int8

# File paths (defaults to ./generated and ./uploads relative to project root)
# BYORN_GENERATED_DIR=/app/generated
# BYORN_UPLOAD_DIR=/app/uploads

# Limits
BYORN_MAX_UPLOAD_SIZE=524288000  # 500 MB

# Audio analysis
BYORN_SILENCE_THRESHOLD_DB=-30.0
BYORN_SILENCE_MIN_DURATION=0.5
BYORN_DENOISE_STRENGTH=0.7

# Image generation defaults
BYORN_IMAGE_DEFAULT_WIDTH=512
BYORN_IMAGE_DEFAULT_HEIGHT=512
BYORN_IMAGE_DEFAULT_STEPS=20
BYORN_IMAGE_DEFAULT_GUIDANCE=7.5

# Optional legacy cloud speech provider. Leave blank unless deliberately enabled.
BYORN_SARVAM_API_KEY=
# BYORN_SARVAM_API_BASE_URL=https://api.sarvam.ai
