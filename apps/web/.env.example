# Environment variables example
# Copy this file to .env.local and update the values as needed

# Node
NODE_ENV=development

# Public
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_MARBLE_API_URL=https://api.marblecms.com

# Google Analytics (optional — leave blank to disable)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# AI Backend — the FastAPI service running at services/ai-backend
# Starts automatically with `docker compose up` or `python run.py` in services/ai-backend
NEXT_PUBLIC_AI_BACKEND_URL=http://localhost:8420

# Server
DATABASE_URL="postgresql://opencut:opencut@localhost:5432/opencut"
BETTER_AUTH_SECRET=your_better_auth_secret

UPSTASH_REDIS_REST_URL=http://localhost:8079
UPSTASH_REDIS_REST_TOKEN=example_token

# Comma-separated admin emails allowed to grant credits (soft launch, no role
# system yet). Empty = nobody is an admin. e.g. ADMIN_EMAILS=you@example.com
ADMIN_EMAILS=

# ── Payments: Polar (credit purchases, merchant-of-record) ──────────────────
# Phase 2 of the credit system. Leave BLANK to keep payments inert — checkout
# and the webhook both no-op until POLAR_ACCESS_TOKEN + POLAR_WEBHOOK_SECRET are
# set. Polar is the merchant of record (handles global tax/VAT).
#   1. Create products in the Polar dashboard (top-up packs + subscription tiers)
#      and paste their product ids into src/lib/payments/catalog.ts.
#   2. Add a webhook endpoint → https://<your-app>/api/webhooks/polar and copy
#      its signing secret below.
# Organization Access Token (server-side; never reaches the browser).
POLAR_ACCESS_TOKEN=
# Webhook signing secret from the Polar webhook endpoint you created.
POLAR_WEBHOOK_SECRET=
# Optional — org id (the access token is already org-scoped; kept for future use).
POLAR_ORGANIZATION_ID=
# Which Polar environment to talk to: "sandbox" (default) or "production".
POLAR_SERVER=sandbox

CLOUDFLARE_ACCOUNT_ID=your_account_id_here
R2_ACCESS_KEY_ID=your_access_key_here
R2_SECRET_ACCESS_KEY=your_secret_key_here
R2_BUCKET_NAME=byorn-media # whatever you named your R2 bucket
# Public read base for R2 (custom domain or r2.dev) so rehosted Studio media
# (Seedance videos, GPT Image stills) get permanent URLs. Leave blank in dev to
# fall back to time-limited presigned URLs.
# R2_PUBLIC_BASE_URL=https://media.yourapp.com

# Optional non-core integrations. Leave blank unless you intentionally enable
# the matching feature.
MARBLE_WORKSPACE_KEY=
FREESOUND_CLIENT_ID=
FREESOUND_API_KEY=
# MODAL_TRANSCRIPTION_URL=

# ---------------------
# AI Backend Environment Variables (for services/ai-backend/.env)
# These are only needed if running the AI backend outside Docker.
# Inside Docker they are set via docker-compose.yml.
# ---------------------
# BYORN_HOST=0.0.0.0
# BYORN_PORT=8420
# BYORN_OLLAMA_URL=http://localhost:11434
# BYORN_OLLAMA_DEFAULT_MODEL=llama3.2
# BYORN_WHISPER_MODEL_SIZE=base        # tiny, base, small, medium, large-v3
# BYORN_WHISPER_DEVICE=auto            # auto, cpu, cuda
# BYORN_WHISPER_COMPUTE_TYPE=int8      # int8, float16, float32
# BYORN_SILENCE_THRESHOLD_DB=-30.0
# BYORN_MAX_UPLOAD_SIZE=524288000      # 500 MB

# ---------------------
# Core Studio cloud APIs (server-side; keys never reach the browser)
# ---------------------

# BytePlus ModelArk — direct Seedance 2.0, no reseller markup. Requires KYC.
# Sign up at https://console.byteplus.com (or Volcengine China) and complete
# real-name verification, then create an API key in the ModelArk console.
BYTEPLUS_API_KEY=
# API base URL. Leave blank for the BytePlus international endpoint
# (https://ark.ap-southeast.bytepluses.com/api/v3). For Volcengine China, set:
# BYTEPLUS_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
BYTEPLUS_BASE_URL=
# Optional: your specific Seedance endpoint/model ID from ModelArk.
# Leave blank to use the default (dreamina-seedance-2-0-260128 on BytePlus intl;
# the doubao-* IDs are Volcengine-China-only and 404 on BytePlus). Check your
# account's models via GET {BYTEPLUS_BASE_URL}/models.
BYTEPLUS_SEEDANCE_ENDPOINT_ID=

# OpenAI — for GPT Image reference frame generation
# Get your key at https://platform.openai.com
OPENAI_API_KEY=
# Override the image model if needed (default: gpt-image-2)
# OPENAI_IMAGE_MODEL=gpt-image-2

# Anthropic — the Director agent's frontier brain (native tool-calling via the
# /api/llm/agent relay; the key stays server-side and never reaches the
# browser). Leave blank to fall back to the local Ollama text loop (privacy
# mode, via NEXT_PUBLIC_AI_BACKEND_URL above).
ANTHROPIC_API_KEY=
# Override the Director's Claude model (default: claude-opus-4-8)
# DIRECTOR_MODEL=claude-opus-4-8

# Kimi (Moonshot) — alternative Director brain via Moonshot's Anthropic-
# compatible endpoint. When set, the /api/llm/agent relay uses Kimi INSTEAD of
# Anthropic (no MCP/Claude Desktop needed). Native tool-calling works as-is.
# Override the model with DIRECTOR_MODEL (e.g. kimi-k2.7-code); default kimi-k2.6.
MOONSHOT_API_KEY=

# ---------------------
# Routed partner backends (server-side; keys never reach the browser)
# ---------------------
# The unified generator routes each slot to a GenerationBackend by intent
# (see apps/web/src/lib/studio/backends/). Every adapter below is real, complete
# code that stays INERT until its key(s) are set — isAvailable() gates it, so an
# unconfigured provider is simply never routed to. Seedance (video) + GPT Image
# (image) above remain the always-on defaults. Leave any of these blank to keep
# that backend disabled.

# — Video —
# Kling (Kuaishou) — direct API, JWT-signed from an access/secret key pair.
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
# KLING_BASE_URL=            # default https://api.klingai.com
# KLING_MODEL=

# Google Gemini API key — SHARED by Veo (video), Imagen (image), and
# Gemini 2.5 Flash Image / "Nano Banana" (image). One key enables all three.
GEMINI_API_KEY=
# GEMINI_BASE_URL=           # default https://generativelanguage.googleapis.com
# GEMINI_VEO_MODEL=          # Veo model id override (preview)
# GEMINI_IMAGEN_MODEL=       # default imagen-4.0-generate-001
# GEMINI_NANO_BANANA_MODEL=  # default gemini-2.5-flash-image

# Runway (Gen-4 / Aleph) — direct API, versioned via X-Runway-Version.
RUNWAY_API_KEY=
# RUNWAY_BASE_URL=           # default https://api.dev.runwayml.com/v1
# RUNWAY_API_VERSION=
# RUNWAY_MODEL=

# Luma (Ray-2 / Dream Machine) — direct API, Bearer auth.
LUMA_API_KEY=
# LUMA_BASE_URL=             # default https://api.lumalabs.ai/dream-machine/v1
# LUMA_MODEL=

# fal.ai — aggregator used for Pika 2.2 (Pika has no public direct API).
FAL_KEY=
# FAL_BASE_URL=              # default https://queue.fal.run

# — Image —
# Black Forest Labs FLUX (flux-pro-1.1-ultra + flux-kontext-pro edits). Auth: x-key.
BFL_API_KEY=
# Ideogram 3.0 — strong text-in-image + character-reference conditioning. Auth: Api-Key.
IDEOGRAM_API_KEY=
# (Imagen + Nano Banana use GEMINI_API_KEY above.)

# NOTE: these partner keys are accessed via process.env directly; they are not
# yet in @byorn/env's zod schema. Add them there if you want validated typing.

# Other legacy/optional cloud providers remain intentionally omitted; Byorn's
# default direction is local-first. Add keys for Sarvam, Smallest, Replicate,
# Stability, Pexels, or direct YouTube upload only when reviving those features.
