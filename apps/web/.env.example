# Environment variables example
# Copy this file to .env.local and update the values as needed.
# Every variable validated by packages/env/src/web.ts appears here, each with a
# one-line note on what breaks without it. The full deploy-oriented matrix
# (required?, where to get it) lives in apps/web/docs/DEPLOY.md.

# ── Node ─────────────────────────────────────────────────────────────────────
# Without it: env validation fails at boot (must be development|production|test).
# Hosts (Vercel, next start) set this themselves — don't override in production.
NODE_ENV=development
# ANALYZE / NEXT_RUNTIME are optional and injected by tooling/Next; never set them by hand.

# ── Public (inlined into the browser bundle at BUILD time) ───────────────────
# Without it: better-auth trusted origin + absolute links fall back to
# http://localhost:3000 — logins and OAuth callbacks break on a real host.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Without it: defaults to the public Marble CMS API (fine); blog needs
# MARBLE_WORKSPACE_KEY below to actually show posts.
NEXT_PUBLIC_MARBLE_API_URL=https://api.marblecms.com
# Without it: Google Analytics is disabled (fine for beta).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Without it: defaults to http://localhost:8420 — local-AI features (Ollama
# brain fallback, transcription, TTS) show "backend offline" unless the
# services/ai-backend FastAPI service runs there.
NEXT_PUBLIC_AI_BACKEND_URL=http://localhost:8420
# Hides/shows the shared-project collaboration UI (invite-by-email, "Shared
# with me", share dialog, onboarding). Beta: off per ADR-003. Set to "true" to
# expose it. Unset reads as OFF. Collab API routes stay live + auth-gated either way.
# NEXT_PUBLIC_FEATURE_COLLAB=false
# Client-only extras (read directly in components, not in the server schema):
# NEXT_PUBLIC_E2E=1                    # build flag: e2e test seam; also disables standalone output
# NEXT_PUBLIC_UNDERSTANDING_MODEL=     # asset-understanding pass model; gemini-* (e.g. gemini-3.5-flash) runs natively via /api/llm/gemini; without it: the Director relay's default brain
# NEXT_PUBLIC_WHISPER_SERVICE_URL=     # optional split-out local AI services
# NEXT_PUBLIC_TTS_SERVICE_URL=
# NEXT_PUBLIC_IMAGE_SERVICE_URL=

# ── Core server (REQUIRED — the app does not boot / function without these) ──
# Without it: env validation throws at boot; nothing runs. Postgres connection
# string (postgres:// or postgresql://).
DATABASE_URL="postgresql://opencut:opencut@localhost:5432/opencut"
# Without it: env validation throws at boot. Signs sessions — generate with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=your_better_auth_secret

# ── Upstash Redis (rate limiting, auth secondary storage, MCP token cache) ───
# Without real values: the app falls back to in-memory rate limiting / caching
# (single instance only — fine for dev, weak on multi-instance hosts).
UPSTASH_REDIS_REST_URL=http://localhost:8079
UPSTASH_REDIS_REST_TOKEN=example_token

# How many trusted reverse proxies sit in front of the app (picks the client IP
# from x-forwarded-for for rate limiting). Without it: defaults to 1, correct
# for Vercel / a single proxy. Set higher only behind an extra LB/CDN layer.
# TRUSTED_PROXY_HOPS=1

# ── Admin / metering ─────────────────────────────────────────────────────────
# Comma-separated admin emails allowed to grant credits (soft launch, no role
# system yet). Without it: nobody can use POST /api/admin/credits/grant.
ADMIN_EMAILS=
# Credit metering kill-switch. Default ON — paid AI actions debit credits and
# return 402 when the user can't afford them. Set to "false" to disable metering
# entirely (every paid generation runs free): useful for a phased rollout or a
# promo period before payments exist.
CREDITS_ENFORCED=true

# ── Transactional email (password reset + email verification) ────────────────
# Without it: the app logs the action link to the server console instead of
# sending email — users can't self-serve password resets in production.
RESEND_API_KEY=
# Without a verified sender on your Resend account, sends are rejected.
EMAIL_FROM="Byorn <noreply@byorn.app>"

# ── Payments: Polar (credit purchases, merchant-of-record) ──────────────────
# Phase 2 of the credit system. Leave BLANK to keep payments inert — checkout
# and the webhook both no-op until POLAR_ACCESS_TOKEN + POLAR_WEBHOOK_SECRET are
# set. Polar is the merchant of record (handles global tax/VAT).
#   1. Create products in the Polar dashboard (top-up packs + subscription tiers)
#      and paste their product ids into src/lib/payments/catalog.ts.
#   2. Add a webhook endpoint → https://<your-app>/api/webhooks/polar and copy
#      its signing secret below.
# Organization Access Token (server-side; never reaches the browser).
POLAR_ACCESS_TOKEN=
# Webhook signing secret from the Polar webhook endpoint you created.
POLAR_WEBHOOK_SECRET=
# Optional — org id (the access token is already org-scoped; kept for future use).
POLAR_ORGANIZATION_ID=
# Which Polar environment to talk to: "sandbox" (default) or "production".
POLAR_SERVER=sandbox

# ── Cloudflare R2 (media storage: uploads, rehosted generations) ─────────────
# Without these: uploads and Studio media rehosting fail — generated clips only
# live on provider URLs that expire. Required for any real deployment.
CLOUDFLARE_ACCOUNT_ID=your_account_id_here
R2_ACCESS_KEY_ID=your_access_key_here
R2_SECRET_ACCESS_KEY=your_secret_key_here
R2_BUCKET_NAME=byorn-media # whatever you named your R2 bucket
# Public read base for R2 (custom domain or r2.dev) so rehosted Studio media
# (Seedance videos, GPT Image stills) get permanent URLs. Without it: falls
# back to time-limited presigned URLs (fine in dev).
# R2_PUBLIC_BASE_URL=https://media.yourapp.com
# Soft storage cap in bytes (default 9500000000 ≈ R2's 10 GB free tier — new
# uploads are refused past it). 0 disables the guard.
# R2_MAX_STORAGE_BYTES=9500000000

# ── Optional non-core integrations ───────────────────────────────────────────
# Without it: the blog section renders empty (no posts).
MARBLE_WORKSPACE_KEY=
# Without these: the Sounds panel search/preview returns nothing (users can
# also paste a personal key in Settings).
FREESOUND_CLIENT_ID=
FREESOUND_API_KEY=
# Without it: stock-photo search returns 401 unless the user pastes a personal
# key in Settings. Free key at pexels.com/api.
PEXELS_API_KEY=
# Without it: cloud transcription is unavailable (local Whisper via the AI
# backend still works).
# MODAL_TRANSCRIPTION_URL=

# ---------------------
# AI Backend Environment Variables (for services/ai-backend/.env)
# These are only needed if running the AI backend outside Docker.
# Inside Docker they are set via docker-compose.yml.
# ---------------------
# BYORN_HOST=0.0.0.0
# BYORN_PORT=8420
# BYORN_OLLAMA_URL=http://localhost:11434
# BYORN_OLLAMA_DEFAULT_MODEL=llama3.2
# BYORN_WHISPER_MODEL_SIZE=base        # tiny, base, small, medium, large-v3
# BYORN_WHISPER_DEVICE=auto            # auto, cpu, cuda
# BYORN_WHISPER_COMPUTE_TYPE=int8      # int8, float16, float32
# BYORN_SILENCE_THRESHOLD_DB=-30.0
# BYORN_MAX_UPLOAD_SIZE=524288000      # 500 MB
# Headless version-control CLI (src/services/version/cli.ts, runs outside the app):
# BYORN_API_URL=http://localhost:3000/api/version-control
# BYORN_API_TOKEN=

# ---------------------
# Core Studio cloud APIs (server-side; keys never reach the browser)
# ---------------------

# BytePlus ModelArk — direct Seedance 2.0, no reseller markup. Requires KYC.
# Without it: the default Studio video backend is inert — no cloud video
# generation unless another video provider below is configured.
# Sign up at https://console.byteplus.com (or Volcengine China) and complete
# real-name verification, then create an API key in the ModelArk console.
BYTEPLUS_API_KEY=
# API base URL. Leave blank for the BytePlus international endpoint
# (https://ark.ap-southeast.bytepluses.com/api/v3). For Volcengine China, set:
# BYTEPLUS_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
BYTEPLUS_BASE_URL=
# Optional: your specific Seedance endpoint/model ID from ModelArk.
# Leave blank to use the default (dreamina-seedance-2-0-260128 on BytePlus intl;
# the doubao-* IDs are Volcengine-China-only and 404 on BytePlus). Check your
# account's models via GET {BYTEPLUS_BASE_URL}/models.
BYTEPLUS_SEEDANCE_ENDPOINT_ID=

# OpenAI — GPT Image reference frame generation. Without it: the default Studio
# image backend is inert (reference stills / hero frames can't generate).
# Get your key at https://platform.openai.com
OPENAI_API_KEY=
# Override the image model if needed (default: gpt-image-2)
# OPENAI_IMAGE_MODEL=gpt-image-2

# Anthropic — the Director agent's frontier brain (native tool-calling via the
# /api/llm/agent relay; the key stays server-side and never reaches the
# browser). Without it (and without MOONSHOT_API_KEY): the Director falls back
# to the local Ollama text loop (privacy mode, via NEXT_PUBLIC_AI_BACKEND_URL).
ANTHROPIC_API_KEY=
# Override the Director's Claude model (default: claude-opus-4-8)
# DIRECTOR_MODEL=claude-opus-4-8

# Kimi (Moonshot) — alternative Director brain via Moonshot's Anthropic-
# compatible endpoint. When set, the /api/llm/agent relay uses Kimi INSTEAD of
# Anthropic (no MCP/Claude Desktop needed). Native tool-calling works as-is.
# Override the model with DIRECTOR_MODEL (e.g. kimi-k2.7-code); default kimi-k2.6.
MOONSHOT_API_KEY=

# Gemini — NATIVE Director brain (its own /api/llm/gemini relay + a native
# function-calling loop; no Anthropic-dialect translation). Uses GEMINI_API_KEY
# below (shared with Imagen). Brain order when several are configured:
# Anthropic/Kimi first, then Gemini, then local Ollama — set DIRECTOR_MODEL to a
# gemini id (default gemini-3.5-flash) to pin the model the Gemini relay runs.

# Director chat is FREE (no credit metering) but each turn bills our own
# provider key, so this is the cost floor. Per-user DAILY cap on Director LLM
# turns, shared by /api/llm/agent and /api/llm/gemini (see RATE_LIMITS in
# src/lib/rate-limit.ts; the per-minute burst cap is fixed at 10/min, not
# env-configurable). Without it: defaults to 150/day — generous for a real
# multi-hour editing session, tight enough to bound a runaway tool loop.
# Owner accounts (OWNER_EMAILS in src/lib/credits/signup-grant.ts) are exempt.
# DIRECTOR_FREE_TURNS_PER_DAY=150

# ---------------------
# Routed partner backends (server-side; keys never reach the browser)
# ---------------------
# The unified generator routes each slot to a GenerationBackend by intent
# (see apps/web/src/lib/studio/backends/). Every adapter below is real, complete
# code that stays INERT until its key(s) are set — isAvailable() gates it, so an
# unconfigured provider is simply never routed to. Seedance (video) + GPT Image
# (image) above remain the always-on defaults. Leave any of these blank to keep
# that backend disabled. All are declared in @byorn/env's zod schema (empty
# string = not configured).

# — Video —
# Kling (Kuaishou) — direct API, JWT-signed from an access/secret key pair.
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
# KLING_BASE_URL=            # default https://api.klingai.com
# KLING_MODEL=

# Google Gemini API key — SHARED by Imagen (image) and Gemini 2.5 Flash Image /
# "Nano Banana" (image). One key enables both.
GEMINI_API_KEY=
# GEMINI_BASE_URL=           # default https://generativelanguage.googleapis.com
# GEMINI_IMAGEN_MODEL=       # default imagen-4.0-generate-001
# GEMINI_NANO_BANANA_MODEL=  # default gemini-2.5-flash-image

# Runway (Gen-4 / Aleph) — direct API, versioned via X-Runway-Version.
RUNWAY_API_KEY=
# RUNWAY_BASE_URL=           # default https://api.dev.runwayml.com/v1
# RUNWAY_API_VERSION=
# RUNWAY_MODEL=

# Luma (Ray-2 / Dream Machine) — direct API, Bearer auth.
LUMA_API_KEY=
# LUMA_BASE_URL=             # default https://api.lumalabs.ai/dream-machine/v1
# LUMA_MODEL=

# fal.ai — aggregator used for Pika 2.2 (Pika has no public direct API).
FAL_KEY=
# FAL_BASE_URL=              # default https://queue.fal.run

# — Image —
# Black Forest Labs FLUX (flux-pro-1.1-ultra + flux-kontext-pro edits). Auth: x-key.
BFL_API_KEY=
# Ideogram 3.0 — strong text-in-image + character-reference conditioning. Auth: Api-Key.
IDEOGRAM_API_KEY=
# (Imagen + Nano Banana use GEMINI_API_KEY above.)

# ── Deploy metadata (optional) ───────────────────────────────────────────────
# Surfaced by GET /api/health as `sha`. Vercel injects VERCEL_GIT_COMMIT_SHA
# automatically; on Docker/other hosts set GIT_SHA yourself if you want it.
# GIT_SHA=

# Other legacy/optional cloud providers remain intentionally omitted; Byorn's
# default direction is local-first. Add keys for Sarvam, Smallest, Replicate,
# Stability, or direct YouTube upload only when reviving those features.

# ---------------------
# Closed beta
# ---------------------
# Shared 4-digit access code the whole site sits behind (src/proxy.ts).
# Rotating it invalidates every visitor's access cookie.
BETA_ACCESS_CODE=6715

# ---------------------
# Closed beta feature gates
# ---------------------
# Only three surfaces may call the shared Gemini pool during the closed beta:
# the Director chat/agent, image generation, and enhance-prompt. Everything
# else that would otherwise spend from GEMINI_API_KEY ships gated OFF by
# default; set either var to the exact string "true" to re-enable it.

# Media "Understanding Pass" — the demand-driven, paid VLM read of each
# imported clip's role/caption/faces/style (services/search/asset-understanding-
# service.ts) and its Library "Insights" tab. Also required (in addition to
# NEXT_PUBLIC_UNDERSTANDING_AUTORUN=1) for the opt-in ingest-time autorun.
# NEXT_PUBLIC_FEATURE_UNDERSTANDING_PASS=true

# Podcast AI — the three Gemini structured-output workflows in
# lib/podcast/podcast-ai.ts (find best clips, keyword highlighting, question
# cards) surfaced in the Podcast Clips panel.
# NEXT_PUBLIC_FEATURE_PODCAST_AI=true
