# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# asdf version management
.tool-versions

node_modules
.cursorignore
.turbo

.env*
!*.env.example

# cursor
bun.lockb

# content-collections
.content-collections

# Twiggy
.cursor/rules/file-structure.mdc

# BlamePrompt staging (auto-generated)
.blameprompt/

# AI Backend
services/ai-backend/.venv/
services/ai-backend/__pycache__/
services/ai-backend/**/__pycache__/
services/ai-backend/*.pyc
services/ai-backend/generated/
services/ai-backend/uploads/
services/ai-backend/*.egg-info/

# AI models and generated content
ai-models/
ai-generated/

*.md

# ...but keep intentionally-tracked docs, notices, and prompt playbooks
!THIRD_PARTY_NOTICES.md
!apps/web/src/lib/studio/playbooks/*.md
!apps/web/docs/poach/*.md
!apps/web/docs/plans/*.md
!CLAUDE.md
!.claude/skills/**/*.md
!.claude/agents/**/*.md

# graphify knowledge-graph build output (regenerate with /graphify .)
graphify-out/

# gitnexus knowledge-graph build output (regenerate with `npx gitnexus analyze`)
.gitnexus/

# per-machine Claude Code state (never share across machines/worktrees)
.claude/settings.local.json
.claude/worktrees/
# generated TS build cache (was causing merge conflicts)
apps/web/tsconfig.tsbuildinfo

# Playwright e2e artifacts + minted media fixtures (regenerated by global-setup)
apps/web/test-results/
apps/web/playwright-report/
apps/web/blob-report/
apps/web/playwright/.cache/
apps/web/e2e/fixtures/
